# Server only. Create the key at https://dashboard.api-football.com/
# Put the value in this file locally, or in the host's secret settings when deploying.
# Never put it in public JavaScript, and do not commit .env.
API_FOOTBALL_KEY=

PORT=4173

# Kickoff times and date groups. Morocco by default.
DISPLAY_TIMEZONE=Africa/Casablanca

# Fastest live refresh while the plan still has room.
# The server slows this automatically when the daily quota is tight.
LIVE_CACHE_SECONDS=30

# Leave this many daily requests for match pages.
QUOTA_RESERVE=25

# Server-only password for /admin. Never put this value in public JavaScript.
ADMIN_TOKEN=

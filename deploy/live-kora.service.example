# Example only. This file is not installed and does not change any host.
# On a persistent server, copy it to /etc/systemd/system/live-kora.service,
# set the paths, then enable it manually with systemd.
[Unit]
Description=Live Kora scores and match monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/live-kora
EnvironmentFile=/opt/live-kora/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
